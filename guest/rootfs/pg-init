#!/bin/sh
# PID 1 of the playground microVM. The root filesystem is a read-only squashfs;
# everything writable is a tmpfs that lives (and dies) with the VM.
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mountpoint -q /dev || mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /dev/shm
mount -t devpts devpts /dev/pts
mount -t tmpfs -o mode=1777,size=16m tmpfs /dev/shm

for d in /tmp /var/tmp; do mount -t tmpfs -o mode=1777,size=64m tmpfs "$d"; done
for d in /run /root /work /var/log; do mount -t tmpfs -o mode=0755,size=64m tmpfs "$d"; done

mount -t tracefs tracefs /sys/kernel/tracing
mount -t debugfs debugfs /sys/kernel/debug
mount -t bpf bpf /sys/fs/bpf
mount -t cgroup2 cgroup2 /sys/fs/cgroup

ip link set lo up
hostname playground

# tini reaps orphans; if the agent ever exits, PID 1 exits, the kernel panics,
# panic=1 + reboot=k makes Firecracker exit, and the host sees the VM is gone.
exec /usr/bin/tini -s -- /usr/bin/python3 -I /opt/pg/agent.py
